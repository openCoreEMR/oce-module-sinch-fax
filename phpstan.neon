parameters:
    level: 10
    paths:
        - src
        - public
        - openemr.bootstrap.php
        - version.php

    # PHP version
    phpVersion: 80500

    # OpenEMR source lives under tools/openemr/vendor (NOT root vendor —
    # see tools/openemr/README.md for the #118 redeclare trap). Load its
    # autoloader so PHPStan can resolve OpenEMR\… types directly from the
    # real source rather than from hand-maintained stubs.
    bootstrapFiles:
        - tools/openemr/vendor/autoload.php

    # Ignore errors in vendor
    excludePaths:
        analyseAndScan:
            - vendor
            - tools/openemr/vendor

    # Additional checks
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true

    # Report always true conditions
    reportAlwaysTrueInLastCondition: true

    # PHPStan analyses against the real OpenEMR autoload (loaded via
    # bootstrapFiles above). OpenEMR's procedural helpers (xlt/xla/xlj/text/
    # attr/sql*) live in library/ and are not autoloaded — they're loaded
    # via globals.php at runtime. Use reportUnmatched: false so the rule
    # applies when the autoload tree is absent (CI without tools/openemr
    # installed) and doesn't trip when it's present.
    ignoreErrors:
        -
            message: '#Function (xlt|xla|xlj|text|attr|sqlStatement|sqlQuery|sqlFetchArray) not found#'
            reportUnmatched: false
        # OpenEMR's global \Document class lives in library/classes and is not
        # PSR-4 autoloaded; it's required directly by the entry points at
        # runtime, so it is unknown during standalone analysis.
        -
            message: '#class Document#'
            reportUnmatched: false
