parameters:
    level: 8
    paths:
        - src
        - public
        - openemr.bootstrap.php
        - version.php

    # PHP version
    phpVersion: 80200

    # Ignore errors in vendor
    excludePaths:
        - vendor

    # Additional checks
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true

    # Report always true conditions
    reportAlwaysTrueInLastCondition: true

    # Ignore errors
    ignoreErrors:
        # OpenEMR global functions not available for static analysis
        - '#Function (xlt|xla|xlj|text|attr|sqlStatement|sqlQuery|sqlFetchArray) not found#'

        # OpenEMR classes not available without full OpenEMR installation
        # reportUnmatched: false allows CI to pass when OpenEMR IS installed
        - message: '#unknown class OpenEMR\\#'
          reportUnmatched: false
        - message: '#Instantiated class OpenEMR\\#'
          reportUnmatched: false
        - message: '#invalid type OpenEMR\\#'
          reportUnmatched: false

        # Class Document from OpenEMR not typed properly
        - '#class Document#'

        # Never-read properties are intentional (event handlers, etc.)
        - '#Property .+ is never read, only written#'

        # OpenEMR GlobalsService::createSection() has incorrect PHPDoc
        # The $beforeSection param is documented as bool but accepts string|false
        # This is an upstream OpenEMR documentation issue
        -
            message: '#Parameter \#2 \$beforeSection of method OpenEMR\\Services\\Globals\\GlobalsService::createSection\(\) expects bool, string given#'
            path: src/Bootstrap.php
            reportUnmatched: false
